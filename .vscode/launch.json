{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Prompt Injection Firewall API",
            "type": "python",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "service.main:app",
                "--host",
                "127.0.0.1",
                "--port",
                "8000"
            ],
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder};${workspaceFolder}/src"
            },
            "console": "integratedTerminal",
            "justMyCode": true,
            "jinja": true
        },
        {
            "name": "Debug Firewall API - Deep Debug",
            "type": "python",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "service.main:app",
                "--host",
                "127.0.0.1",
                "--port",
                "8000",
                "--log-level",
                "debug"
            ],
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder};${workspaceFolder}/src"
            },
            "console": "integratedTerminal",
            "justMyCode": false,
            "jinja": true
        },
        {
            "name": "Debug Demo Agent",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/demo_agent/run_demo.py",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder};${workspaceFolder}/src"
            },
            "console": "integratedTerminal",
            "justMyCode": true,
            "jinja": true
        }
    ]
}